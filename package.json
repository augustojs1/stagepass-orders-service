{
  "name": "stagepass-workers",
  "version": "0.0.1",
  "description": "StagePass Workers handles background jobs like reservations expiration, automated PDF generation, payments processing and emails.",
  "author": "Augusto Souza",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.966.0",
